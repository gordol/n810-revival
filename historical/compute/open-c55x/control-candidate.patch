+/* BCC l4 and the repeat-block offsets are unsigned; B/CALL Lx and
+   the wider conditional branch offsets are signed (TI SPRU374G). */
+static int
+pc_offset_fits (offsetT value, int bits, const char *mask)
+{
+  int unsigned_offset = bits == 4
+    || strncmp (mask, "0000111p", 8) == 0
+    || strncmp (mask, "0100101p 1", 10) == 0;
+  if (unsigned_offset)
+    return value >= 0 && value <= ((1LL << bits) - 1);
+  return value >= -(1LL << (bits - 1))
+    && value <= ((1LL << (bits - 1)) - 1);
+}
