#!/bin/sh
# Initialize and update the N810's small, allowlisted pass namespace.
set -eu

pass_bin=${N810_PASS_BIN:-pass}
gpg_bin=${N810_GPG_BIN:-gpg}
store=${PASSWORD_STORE_DIR:-$HOME/.password-store}

if test -z "${GPG_TTY:-}"; then
	tty_path=$(tty 2>/dev/null || true)
	case "$tty_path" in /dev/*) GPG_TTY=$tty_path; export GPG_TTY;; esac
fi

entry_name()
{
	case "$1" in
		mail-imap|mail-smtp) printf 'n810/%s\n' "$1" ;;
		*) echo 'Unknown secret name' >&2; exit 2 ;;
	esac
}

ready()
{
	test -s "$store/.gpg-id"
}

case "${1:-status}" in
status)
	if ready; then
		echo 'store=ready'
	else
		echo 'store=not-initialized'
		exit 1
	fi
	for name in mail-imap mail-smtp; do
		if test -s "$store/$(entry_name "$name").gpg"; then state=present; else state=missing; fi
		printf '%s=%s\n' "$name" "$state"
	done
	;;
init)
	test "$#" -le 2 || { echo 'Usage: n810-secrets init [GPG-FINGERPRINT]' >&2; exit 2; }
	command -v "$pass_bin" >/dev/null 2>&1 || { echo 'pass is not installed' >&2; exit 127; }
	command -v "$gpg_bin" >/dev/null 2>&1 || { echo 'gpg is not installed' >&2; exit 127; }
	if ready; then echo 'Password store is already initialized.'; exit 0; fi
	recipient=${2:-}
	if test -z "$recipient"; then
		printf 'Existing GPG secret-key fingerprint: ' >&2
		IFS= read -r recipient
	fi
	case "$recipient" in ''|*[!A-Fa-f0-9]*) echo 'Use a hexadecimal GPG fingerprint or long key ID.' >&2; exit 2;; esac
	test "${#recipient}" -ge 16 || { echo 'Use at least a 16-digit long key ID; a full fingerprint is preferred.' >&2; exit 2; }
	"$gpg_bin" --batch --list-secret-keys "$recipient" >/dev/null 2>&1 || {
		echo 'That GPG secret key is not available in this user keyring.' >&2
		exit 1
	}
	umask 077
	"$pass_bin" init "$recipient"
	;;
set)
	test "$#" -eq 2 || { echo 'Usage: n810-secrets set {mail-imap|mail-smtp}' >&2; exit 2; }
	ready || { echo 'Initialize the password store first: n810-secrets init' >&2; exit 1; }
	command -v "$pass_bin" >/dev/null 2>&1 || { echo 'pass is not installed' >&2; exit 127; }
	entry=$(entry_name "$2")
	echo "Enter $2 credential into pass. Input is hidden by pass." >&2
	"$pass_bin" insert --force "$entry"
	;;
has)
	test "$#" -eq 2 || { echo 'Usage: n810-secrets has {mail-imap|mail-smtp}' >&2; exit 2; }
	ready && test -s "$store/$(entry_name "$2").gpg"
	;;
unlock)
	test "$#" -eq 1 || { echo 'Usage: n810-secrets unlock' >&2; exit 2; }
	ready || { echo 'Password store is not initialized.' >&2; exit 1; }
	command -v "$pass_bin" >/dev/null 2>&1 || { echo 'pass is not installed' >&2; exit 127; }
	for name in mail-imap mail-smtp; do
		entry=$(entry_name "$name")
		test -s "$store/$entry.gpg" || { echo "Missing pass entry: $entry" >&2; exit 1; }
		"$pass_bin" show "$entry" >/dev/null
	done
	echo 'Mail credentials are unlocked in gpg-agent for its configured cache period.'
	;;
*)
	echo 'Usage: n810-secrets {status|init [GPG-FINGERPRINT]|set NAME|has NAME|unlock}' >&2
	exit 2
	;;
esac
