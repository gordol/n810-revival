#!/bin/sh
set -eu
run_dir=${N810_POWERD_RUN_DIR:-/run/n810-powerd}
proc_root=${N810_PROC_ROOT:-/proc}

daemon_running()
{
	pid=
	test -r "$run_dir/pid" && IFS= read -r pid < "$run_dir/pid" || return 1
	case "$pid" in ''|*[!0-9]*) return 1;; esac
	test -d "$proc_root/$pid" || return 1
	test -d "$proc_root" || return 0
	if test -r "$run_dir/starttime"; then
		starttime=
		IFS= read -r starttime < "$run_dir/starttime" || return 1
		test -n "$starttime" && test "$starttime" = "$(awk '{print $22}' "$proc_root/$pid/stat" 2>/dev/null)"
	else
		tr '\000' '\n' < "$proc_root/$pid/cmdline" 2>/dev/null | grep -Fq '/n810-powerd'
	fi
}

case "${1:-status}" in
status)
	if daemon_running && test -r "$run_dir/status"; then
		cat "$run_dir/status"
	else
		echo "n810-powerd is not running"
	fi
	;;
inhibit|cancel)
	minutes=${2:-5}
	case "$minutes" in *[!0-9]*|'') echo "Minutes must be a whole number" >&2; exit 2;; esac
	test "$minutes" -ge 1 && test "$minutes" -le 60 || {
		echo 'Minutes must be between 1 and 60.' >&2
		exit 2
	}
	daemon_running && test -d "$run_dir/requests" || { echo "n810-powerd is not running" >&2; exit 1; }
	now=$(date +%s)
	request="$run_dir/requests/$1-$now-$$"
	tmp=$(mktemp "$run_dir/requests/.request.XXXXXX")
	trap 'rm -f "$tmp"' EXIT HUP INT TERM
	printf '%s %s\n' "$1" $((now + minutes * 60)) > "$tmp"
	mv "$tmp" "$request"
	trap - EXIT HUP INT TERM
	;;
*)
	echo "Usage: $0 {status|inhibit [MINUTES]|cancel [MINUTES]}" >&2
	exit 2
	;;
esac
