#!/bin/sh
# SPDX-FileCopyrightText: 2026 Thomas Gordon Lowrey IV
# SPDX-License-Identifier: GPL-2.0-or-later
# A temporary console leaves the foreground Pocket VT intact.
set -eu
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH
TERM=linux
export TERM
while :; do
    status=$(/usr/local/bin/n810-power --tmux 2>/dev/null || echo 'Battery status unavailable')
    radio=$(/usr/local/sbin/n810-radio status 2>/dev/null || echo 'Radio status unavailable')
    choice=$(whiptail --title 'N810 power' --menu "$status; $radio" 24 76 16 \
        return 'Return to Pocket' \
        brighter 'LCD brighter' dimmer 'LCD dimmer' auto 'Auto brightness' \
        off 'Turn display off' on 'Turn display on' \
        charging 'Quiet charging' airplane-on 'Airplane mode on' airplane-off 'Airplane mode off' \
        save 'CPU power save' balanced 'CPU balanced' performance 'CPU performance' \
        topoff 'Top off battery (85-95%)' longevity 'Battery longevity (55-80%)' \
        restart 'Restart' shutdown 'Shut down' \
        3>&1 1>&2 2>&3) || exit 0
    case "$choice" in
        return) exit 0 ;;
        brighter|dimmer|auto|off|on)
            if ! /usr/local/sbin/n810-screen "$choice"; then
                whiptail --title 'Display action failed' --msgbox 'Check the display service over USB SSH.' 9 58
            fi
            case "$choice" in off|on) exit 0;; esac ;;
        charging)
            if result=$(/usr/local/sbin/n810-mode charging 2>&1); then exit 0; fi
            whiptail --title 'Quiet charging unavailable' --msgbox "$result" 10 65 ;;
        airplane-on|airplane-off)
            if ! result=$(/usr/local/sbin/n810-radio "$choice" 2>&1); then
                whiptail --title 'Radio action failed' --msgbox "$result" 10 65
            fi ;;
        save|balanced|performance)
            if ! result=$(/usr/local/sbin/n810-cpu-policy "$choice" 2>&1); then
                whiptail --title 'CPU policy unavailable' --msgbox "$result" 10 65
            fi ;;
        topoff|longevity)
            if ! result=$(/usr/local/bin/n810-power "$choice" 2>&1); then
                whiptail --title 'Charging control unavailable' --msgbox "$result" 10 65
            fi ;;
        restart|shutdown)
            if whiptail --title 'Confirm power action' --yesno "${choice} the N810?" 10 55; then
                if test "$choice" = restart; then exec /sbin/reboot; fi
                exec /sbin/poweroff
            fi ;;
        *) exit 2 ;;
    esac
done
