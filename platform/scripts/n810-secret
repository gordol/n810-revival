#!/bin/sh
# Return the first line of one allowlisted pass entry for a client PassCmd.
set -eu

pass_bin=${N810_PASS_BIN:-pass}
name=${1:-}
case "$name" in
	mail-imap|mail-smtp) ;;
	*) echo 'Usage: n810-secret {mail-imap|mail-smtp}' >&2; exit 2 ;;
esac
test "$#" -eq 1 || { echo 'Usage: n810-secret {mail-imap|mail-smtp}' >&2; exit 2; }
command -v "$pass_bin" >/dev/null 2>&1 || { echo 'pass is not installed' >&2; exit 127; }

if test -z "${GPG_TTY:-}"; then
	tty_path=$(tty 2>/dev/null || true)
	case "$tty_path" in /dev/*) GPG_TTY=$tty_path; export GPG_TTY;; esac
fi

secret=$($pass_bin show "n810/$name") || exit $?
printf '%s\n' "$secret" | sed -n '1p'
