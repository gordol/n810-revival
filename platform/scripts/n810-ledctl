#!/bin/sh
set -eu

run_dir=${N810_LEDD_RUN_DIR:-/run/n810-ledd}
proc_root=${N810_PROC_ROOT:-/proc}

daemon_running()
{
	pid=
	test -r "$run_dir/pid" && IFS= read -r pid < "$run_dir/pid" || return 1
	case "$pid" in ''|*[!0-9]*) return 1;; esac
	test -d "$proc_root/$pid" || return 1
	test -d "$proc_root" || return 0
	if test -r "$run_dir/starttime"; then
		starttime=
		IFS= read -r starttime < "$run_dir/starttime" || return 1
		test -n "$starttime" && test "$starttime" = "$(awk '{print $22}' "$proc_root/$pid/stat" 2>/dev/null)"
	else
		tr '\000' '\n' < "$proc_root/$pid/cmdline" 2>/dev/null | grep -Fq '/n810-ledd'
	fi
}
if test -n "${N810_LED_CONFIG:-}"; then
	config=$N810_LED_CONFIG
elif test -r "${XDG_CONFIG_HOME:-$HOME/.config}/n810-led.conf"; then
	config=${XDG_CONFIG_HOME:-$HOME/.config}/n810-led.conf
else
	config=/etc/n810-led.conf
fi

resolve_color()
{
	namespace=$1
	case "$namespace" in *[!A-Za-z0-9_.-]*|'') echo "Invalid namespace" >&2; exit 2;; esac
	case "$namespace" in
	red|amber|green|blue|white|flashlight) color=$namespace ;;
	*) color=$(sed -n "s/^${namespace}=//p" "$config" 2>/dev/null | tail -n 1) ;;
	esac
	case "$color" in red|amber|green|blue|white|flashlight) ;; *) echo "No valid color for namespace: $namespace" >&2; exit 2;; esac
}

notify()
{
	namespace=$1; seconds=$2
	case "$seconds" in *[!0-9]*|'') echo "Duration must be whole seconds" >&2; exit 2;; esac
	resolve_color "$namespace"
	max_seconds=3600
	test "$color" != flashlight || max_seconds=300
	test "$seconds" -ge 1 && test "$seconds" -le "$max_seconds" || {
		echo "Duration must be between 1 and $max_seconds seconds" >&2
		exit 2
	}
	daemon_running && test -d "$run_dir/requests" || { echo "n810-ledd is not running" >&2; exit 1; }
	now=$(date +%s)
	request="$run_dir/requests/notify-$now-$$"
	tmp=$(mktemp "$run_dir/requests/.request.XXXXXX")
	trap 'rm -f "$tmp"' EXIT HUP INT TERM
	printf '%s %s %s\n' "$namespace" "$color" $((now + seconds)) > "$tmp"
	mv "$tmp" "$request"
	trap - EXIT HUP INT TERM
	test -p "$run_dir/wake" && printf 'notify\n' > "$run_dir/wake" || true
}

case "${1:-status}" in
status)
	if daemon_running && test -r "$run_dir/status"; then
		cat "$run_dir/status"
	else
		echo "n810-ledd is not running"
	fi
	;;
notify)
	notify "${2:-default}" "${3:-5}"
	;;
flashlight)
	seconds=${2:-5}
	notify flashlight "$seconds"
	;;
preview)
	for color in red amber green blue white; do
		echo "$color"
		notify "$color" 7
		sleep 7
	done
	;;
*)
	echo "Usage: $0 {status|notify NAMESPACE [SECONDS]|flashlight [SECONDS]|preview}" >&2
	exit 2
	;;
esac
