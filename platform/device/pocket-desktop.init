#!/bin/sh
### BEGIN INIT INFO
# Provides:          pocket-desktop
# Required-Start:    $local_fs n810-setup-touch n810-console-ux
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Pocket graphical desktop
### END INIT INFO
set -eu
pidfile=/run/pocket-desktop.pid
case "${1:-}" in
start)
    test "$(/usr/local/sbin/n810-mode status)" != charging || exit 0
    logdir=/var/log/n810-pocket-native
    install -d -m 700 "$logdir"
    start-stop-daemon --start --quiet --background --no-close --make-pidfile --pidfile "$pidfile" \
        --startas /usr/bin/python3 -- -I /usr/local/lib/n810-pocket/native_owner.py >>"$logdir/launcher.log" 2>&1
    ;;
stop)
    start-stop-daemon --stop --quiet --retry TERM/20/KILL/2 --pidfile "$pidfile" \
        --exec /usr/bin/python3 --remove-pidfile || true
    ;;
restart|force-reload) "$0" stop; "$0" start;;
status) start-stop-daemon --stop --test --quiet --pidfile "$pidfile" --exec /usr/bin/python3;;
*) echo 'Usage: pocket-desktop {start|stop|restart|status}' >&2; exit 2;;
esac
