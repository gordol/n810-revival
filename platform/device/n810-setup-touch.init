#!/bin/sh
### BEGIN INIT INFO
# Provides:          n810-setup-touch
# Required-Start:    $local_fs n810-console-ux ssh
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:
# Short-Description: Calibrate this tablet's touchscreen on first boot
### END INIT INFO
set -eu
case "${1:-}" in
start)
    test ! -s /etc/n810/touch-calibration.json || exit 0
    chvt 1
    kbd_mode -u -C /dev/tty1
    timeout 320 /usr/local/sbin/n810-setup-touch --first-boot </dev/tty1 >/dev/tty1 2>&1
    ;;
stop) :;;
status) test -s /etc/n810/touch-calibration.json;;
*) echo 'Usage: n810-setup-touch {start|stop|status}' >&2; exit 2;;
esac
