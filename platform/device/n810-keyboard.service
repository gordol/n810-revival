[Unit]
Description=N810 console hardware-button overlay
Requires=n810-fn-remap.service
After=console-setup.service keyboard-setup.service n810-fn-remap.service
Before=getty@tty1.service pocket-desktop.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/n810-keyboard apply
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
