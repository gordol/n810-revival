[Unit]
Description=N810 compressed swap
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/n810-zram start
ExecStop=/usr/local/sbin/n810-zram stop

[Install]
WantedBy=multi-user.target
