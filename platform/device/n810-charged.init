#!/bin/sh
### BEGIN INIT INFO
# Provides:          n810-charged
# Required-Start:    $local_fs
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Nokia N810 fail-safe charging policy
### END INIT INFO

case "${1:-}" in
	start)
		start-stop-daemon --start --quiet --background --make-pidfile \
			--pidfile /run/n810-charged.pid \
			--name n810-charged \
			--startas /usr/local/sbin/n810-charged
		;;
	stop)
		start-stop-daemon --stop --quiet --retry TERM/5/KILL/2 \
			--pidfile /run/n810-charged.pid --name n810-charged || true
		# Also stop a matching orphan if a stale pidfile was overwritten.
		start-stop-daemon --stop --quiet --retry TERM/5/KILL/2 \
			--name n810-charged --ppid 1 || true
		rm -f /run/n810-charged.pid
		;;
	restart|force-reload)
		"$0" stop
		"$0" start
		;;
	*)
		echo "Usage: $0 {start|stop|restart|force-reload}" >&2
		exit 2
		;;
esac
