[Unit]
Description=N810 internal Fn chord translator
After=systemd-udev-trigger.service
Before=getty@tty1.service n810-keyboard.service

[Service]
Type=simple
ExecStartPre=/sbin/modprobe uinput
ExecStartPre=/usr/local/sbin/n810-fn-remap --check
ExecStart=/usr/local/sbin/n810-fn-remap
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
