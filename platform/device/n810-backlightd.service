[Unit]
Description=N810 keyboard backlight policy
After=systemd-udev-settle.service n810-fn-remap.service
ConditionPathExists=/sys/class/leds/n810::keyboard/brightness

[Service]
Type=simple
ExecStart=/usr/local/sbin/n810-backlightd
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
