#!/bin/sh
### BEGIN INIT INFO
# Provides:          n810-console-blank
# Required-Start:    $local_fs
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:
# Short-Description: Disable automatic N810 console blanking
### END INIT INFO
set -eu
case "${1:-start}" in
    start|stop|restart|force-reload)
        # Do not poke the console: boot/service maintenance must not wake it.
        TERM=linux /usr/bin/setterm --blank 0 < /dev/tty1 > /dev/tty1
        TERM=linux /usr/bin/setterm --powerdown 0 < /dev/tty1 > /dev/tty1
        ;;
    *) echo "Usage: $0 {start|stop|restart|force-reload}" >&2; exit 2 ;;
esac
