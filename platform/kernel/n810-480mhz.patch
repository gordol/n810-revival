+static int omap_cpufreq_reboot(struct notifier_block *nb,
+			      unsigned long action, void *data)
+{
+	struct clk *clk;
+
+	if (action != SYS_RESTART)
+		return NOTIFY_DONE;
+
+	clk = clk_get(NULL, "cpufreq_ck");
+	if (!IS_ERR(clk)) {
+		if (clk_set_rate(clk, 330000000))
+			pr_warn("failed to restore boot clock before restart\n");
+		clk_put(clk);
+	}
+	return NOTIFY_DONE;
+}
