+	size_t size = fw->size;
+	unsigned int command_count;
+	unsigned int command = 0;
+	u8 bdaddr[6];
+	int err;
+
+	err = nokia_csr_fw_validate(fw, &command_count);
+	if (err) {
+		dev_err(dev, "invalid CSR BC4 firmware image");
+		return err;
+	}
+
+	mutex_lock(&btdev->bdaddr_lock);
+	memcpy(bdaddr, btdev->bdaddr, sizeof(bdaddr));
+	mutex_unlock(&btdev->bdaddr_lock);
+	if (!memchr_inv(bdaddr, 0, sizeof(bdaddr))) {
+		dev_err(dev, "calibrated Bluetooth address is not set");
+		return -EINVAL;
+	}
+
+	WRITE_ONCE(btdev->csr_fw_loading, true);
+	while (size) {
+		struct sk_buff *skb;
+		u8 *packet;
+		u8 len = *ptr++;
+		long timeout;
+
+		size--;
+		if (!len)
+			break;
+		if (ptr[0] != HCI_COMMAND_PKT)
+			goto next;
+
+		packet = kmemdup(ptr, len, GFP_KERNEL);
+		if (!packet) {
+			err = -ENOMEM;
+			goto done;
+		}
+		if (len > 28 && packet[15] == 0x01 && packet[16] == 0x00)
+			nokia_csr_patch_bdaddr(packet, bdaddr);
+
+		skb = bt_skb_alloc(len - 1, GFP_KERNEL);
+		if (!skb) {
+			kfree(packet);
+			err = -ENOMEM;
+			goto done;
+		}
+		hci_skb_pkt_type(skb) = HCI_COMMAND_PKT;
+		skb_put_data(skb, packet + 1, len - 1);
+		kfree(packet);
