+static void p54spi_sync(struct p54s_priv *priv, struct spi_message *m)
+{
+	struct spi_message split;
+	struct spi_transfer *xfer, *parts = NULL;
+	unsigned int count = 0, index = 0;
+	int ret;
+
+	if (force_pio) {
+		list_for_each_entry(xfer, &m->transfers, transfer_list)
+			count += DIV_ROUND_UP(xfer->len, 128);
+		parts = kcalloc(count, sizeof(*parts), GFP_KERNEL);
+		if (!parts) {
+			atomic_inc(&spi_errors);
+			dev_err_ratelimited(&priv->spi->dev, "SPI split allocation failed\n");
+			return;
+		}
+		spi_message_init(&split);
+		list_for_each_entry(xfer, &m->transfers, transfer_list) {
+			unsigned int offset;
+			for (offset = 0; offset < xfer->len; offset += 128) {
+				struct spi_transfer *part = &parts[index++];
+				*part = *xfer;
+				part->len = min_t(unsigned int, 128, xfer->len - offset);
+				if (xfer->tx_buf) part->tx_buf = (const u8 *)xfer->tx_buf + offset;
+				if (xfer->rx_buf) part->rx_buf = (u8 *)xfer->rx_buf + offset;
+				if (offset + part->len < xfer->len) {
+					part->cs_change = 0;
+					part->delay.value = 0;
+				}
+				spi_message_add_tail(part, &split);
+			}
+		}
+		m = &split;
+	}
+	ret = spi_sync(priv->spi, m);
+	kfree(parts);
+	if (ret) {
+		atomic_inc(&spi_errors);
+		dev_err_ratelimited(&priv->spi->dev, "SPI transfer failed: %d\n", ret);
+	}
+}
