+			goto done;
+		}
+		hci_uart_tx_wakeup(hu);
+
+		command++;
+		if (command == command_count)
+			goto next;
+
+		timeout = wait_for_completion_timeout(&btdev->fw_completion,
+						      msecs_to_jiffies(1000));
