+
+static void tsl2563_unlock(struct tsl2563_chip *chip)
+{
+	/* Event detection needs sensor power between register accesses. */
+	if (!chip->int_enabled || chip->suspended) {
+		clk_disable_unprepare(chip->supply_clk);
+		chip->supply_held = false;
+	}
+	mutex_unlock(&chip->lock);
+}
