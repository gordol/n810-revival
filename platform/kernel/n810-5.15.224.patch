+struct rfbi_reg { u16 idx; };
+
+#define RFBI_REG(idx)		((const struct rfbi_reg) { idx })
+
+#define RFBI_REVISION		RFBI_REG(0x0000)
+#define RFBI_SYSCONFIG		RFBI_REG(0x0010)
+#define RFBI_SYSSTATUS		RFBI_REG(0x0014)
+#define RFBI_CONTROL		RFBI_REG(0x0040)
+#define RFBI_PIXEL_CNT		RFBI_REG(0x0044)
+#define RFBI_LINE_NUMBER	RFBI_REG(0x0048)
+#define RFBI_CMD		RFBI_REG(0x004c)
+#define RFBI_PARAM		RFBI_REG(0x0050)
+#define RFBI_DATA		RFBI_REG(0x0054)
+#define RFBI_READ		RFBI_REG(0x0058)
+#define RFBI_STATUS		RFBI_REG(0x005c)
+
+#define RFBI_CONFIG(n)		RFBI_REG(0x0060 + (n)*0x18)
+#define RFBI_ONOFF_TIME(n)	RFBI_REG(0x0064 + (n)*0x18)
+#define RFBI_CYCLE_TIME(n)	RFBI_REG(0x0068 + (n)*0x18)
+#define RFBI_DATA_CYCLE1(n)	RFBI_REG(0x006c + (n)*0x18)
+#define RFBI_DATA_CYCLE2(n)	RFBI_REG(0x0070 + (n)*0x18)
+#define RFBI_DATA_CYCLE3(n)	RFBI_REG(0x0074 + (n)*0x18)
+
+#define RFBI_VSYNC_WIDTH	RFBI_REG(0x0090)
+#define RFBI_HSYNC_WIDTH	RFBI_REG(0x0094)
+
+#define REG_FLD_MOD(idx, val, start, end) \
+	rfbi_write_reg(dssdev, idx, FLD_MOD(rfbi_read_reg(dssdev, idx), val, start, end))
+
+enum omap_rfbi_cycleformat {
+	OMAP_DSS_RFBI_CYCLEFORMAT_1_1 = 0,
+	OMAP_DSS_RFBI_CYCLEFORMAT_2_1 = 1,
+	OMAP_DSS_RFBI_CYCLEFORMAT_3_1 = 2,
+	OMAP_DSS_RFBI_CYCLEFORMAT_3_2 = 3,
+};
+
+enum omap_rfbi_datatype {
+	OMAP_DSS_RFBI_DATATYPE_12 = 0,
+	OMAP_DSS_RFBI_DATATYPE_16 = 1,
+	OMAP_DSS_RFBI_DATATYPE_18 = 2,
+	OMAP_DSS_RFBI_DATATYPE_24 = 3,
+};
+
+enum omap_rfbi_parallelmode {
+	OMAP_DSS_RFBI_PARALLELMODE_8 = 0,
+	OMAP_DSS_RFBI_PARALLELMODE_9 = 1,
+	OMAP_DSS_RFBI_PARALLELMODE_12 = 2,
+	OMAP_DSS_RFBI_PARALLELMODE_16 = 3,
+};
+
+static int rfbi_convert_timings(struct omap_dss_device *dssdev, struct rfbi_timings *t);
+static void rfbi_get_clk_info(struct omap_dss_device *dssdev, u32 *clk_period, u32 *max_clk_div);
+
+struct rfbi_data {
+	struct platform_device *pdev;
+	void __iomem	*base;
+
+	unsigned long	l4_khz;
+
+	enum omap_rfbi_datatype datatype;
+	enum omap_rfbi_parallelmode parallelmode;
+
+	enum omap_rfbi_te_mode te_mode;
+	int te_enabled;
+
+	void (*framedone_callback)(void *data);
+	void *framedone_callback_data;
+
+	struct mutex lock;
+	struct semaphore bus_lock;
+
+	struct omap_video_timings timings;
+	int pixel_size;
+	int data_lines;
+	struct rfbi_timings intf_timings;
+
+	struct omap_dss_device output;
+} _rfbi;
+struct rfbi_data *rfbi = &_rfbi;
+
+static inline void rfbi_write_reg(struct omap_dss_device *dssdev, const struct rfbi_reg idx, u32 val)
+{
+	__raw_writel(val, rfbi->base + idx.idx);
+}
+
+static inline u32 rfbi_read_reg(struct omap_dss_device *dssdev, const struct rfbi_reg idx)
+{
+	return __raw_readl(rfbi->base + idx.idx);
+}
+
+static void rfbi_log_state(struct omap_dss_device *dssdev, const char *tag)
+{
+	pr_debug("N810-DISPLAY %s rfbi syscfg=%08x sysstat=%08x control=%08x "
+		"status=%08x cfg0=%08x onoff0=%08x cycle0=%08x "
+		"data1=%08x data2=%08x data3=%08x vsync=%08x hsync=%08x\n",
+		tag,
+		rfbi_read_reg(dssdev, RFBI_SYSCONFIG),
+		rfbi_read_reg(dssdev, RFBI_SYSSTATUS),
+		rfbi_read_reg(dssdev, RFBI_CONTROL),
+		rfbi_read_reg(dssdev, RFBI_STATUS),
+		rfbi_read_reg(dssdev, RFBI_CONFIG(0)),
+		rfbi_read_reg(dssdev, RFBI_ONOFF_TIME(0)),
+		rfbi_read_reg(dssdev, RFBI_CYCLE_TIME(0)),
+		rfbi_read_reg(dssdev, RFBI_DATA_CYCLE1(0)),
+		rfbi_read_reg(dssdev, RFBI_DATA_CYCLE2(0)),
+		rfbi_read_reg(dssdev, RFBI_DATA_CYCLE3(0)),
+		rfbi_read_reg(dssdev, RFBI_VSYNC_WIDTH),
+		rfbi_read_reg(dssdev, RFBI_HSYNC_WIDTH));
+}
