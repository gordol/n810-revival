+/* RX-44 sensor VDD depends on SYS_CLKREQ, which drops in full retention. */
+static int tsl2563_lock(struct tsl2563_chip *chip)
+{
+	int ret;
+
+	mutex_lock(&chip->lock);
+	if (chip->supply_held)
+		return 0;
+	ret = clk_prepare_enable(chip->supply_clk);
+	if (ret)
+		mutex_unlock(&chip->lock);
+	else
+		chip->supply_held = true;
+	return ret;
