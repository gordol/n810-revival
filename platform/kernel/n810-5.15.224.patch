+static int nokia_csr_fw_validate(const struct firmware *fw,
+				 unsigned int *command_count)
+{
+	const u8 *ptr = fw->data;
+	size_t size = fw->size;
+	bool has_bdaddr = false;
+	unsigned int count = 0;
+
+	while (size) {
+		u8 len = *ptr++;
+
+		size--;
+		if (!len)
+			break;
+		if (len > size)
+			return -EINVAL;
+
+		if (ptr[0] == HCI_COMMAND_PKT) {
+			count++;
+			if (len > 28 && ptr[15] == 0x01 && ptr[16] == 0x00)
+				has_bdaddr = true;
+		}
+
+		ptr += len;
+		size -= len;
+	}
+
+	if (!count || !has_bdaddr)
+		return -EINVAL;
+
+	*command_count = count;
+	return 0;
+}
+
+static void nokia_csr_patch_bdaddr(u8 *packet, const u8 *bdaddr)
+{
+	packet[22] = 0x00;
+	packet[26] = 0x00;
+	packet[28] = bdaddr[0];
+	packet[27] = bdaddr[1];
+	packet[25] = bdaddr[2];
+	packet[21] = bdaddr[3];
+	packet[24] = bdaddr[4];
+	packet[23] = bdaddr[5];
+}
