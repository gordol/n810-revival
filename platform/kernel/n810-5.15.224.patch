+/* STLC4560 rev F sections 4.3, 5.13-5.15: host DMA RAM reads. */
+static void p54spi_verify_ram_sample(struct p54s_priv *priv, const u8 *fw,
+				   unsigned int offset)
+{
+	u8 readback[64];
+	unsigned int i, mismatches = 0, first = sizeof(readback);
+	u32 control, ints = 0;
+	int errors_before = atomic_read(&spi_errors);
+
+	if (!p54spi_wait_bit(priv, SPI_ADRS_DMA_READ_CTRL, HOST_ALLOWED)) {
+		dev_warn(&priv->spi->dev, "ram-verify offset=%u: read channel not host-allowed\n", offset);
+		return;
+	}
+	p54spi_write16(priv, SPI_ADRS_DMA_READ_CTRL, cpu_to_le16(SPI_DMA_READ_CTRL_ENABLE));
+	p54spi_write16(priv, SPI_ADRS_DMA_READ_LEN, cpu_to_le16(sizeof(readback)));
+	p54spi_write32(priv, SPI_ADRS_DMA_READ_BASE,
+		      cpu_to_le32(ISL38XX_DEV_FIRMWARE_ADDR + offset));
+	/* Allow the documented AHB prefetch interval before reading DATA. */
+	usleep_range(1000, 2000);
+	for (i = 0; i < 100; i++) {
+		ints = p54spi_read32(priv, SPI_ADRS_HOST_INTERRUPTS);
+		if (ints & SPI_HOST_INT_UPDATE)
+			break;
+		usleep_range(1000, 2000);
+	}
+	if (!(ints & SPI_HOST_INT_UPDATE)) {
+		dev_warn(&priv->spi->dev, "ram-verify offset=%u: prefetch timeout host_ints=%08x\n", offset, ints);
+		goto disable;
+	}
+	p54spi_spi_read(priv, SPI_ADRS_DMA_DATA, readback, sizeof(readback));
+	for (i = 0; i < sizeof(readback); i++) {
+		if (readback[i] != fw[offset + i]) {
+			if (first == sizeof(readback)) first = i;
+			mismatches++;
+		}
+	}
+	if (atomic_read(&spi_errors) != errors_before) {
+		dev_warn(&priv->spi->dev, "ram-verify offset=%u: SPI transport error; comparison invalid\n", offset);
+	} else if (mismatches) {
+		dev_warn(&priv->spi->dev,
+			 "ram-verify offset=%u: mismatches=%u/64 first=%u expected=%02x actual=%02x expected16=%*ph actual16=%*ph\n",
+			 offset, mismatches, first, fw[offset + first], readback[first],
+			 16, fw + offset, 16, readback);
+	} else {
+		dev_info(&priv->spi->dev, "ram-verify offset=%u: MATCH 64/64\n", offset);
+	}
+disable:
+	control = p54spi_read32(priv, SPI_ADRS_DMA_READ_CTRL);
+	if (control & HOST_ALLOWED)
+		p54spi_write16(priv, SPI_ADRS_DMA_READ_CTRL, cpu_to_le16(0));
+	p54spi_write32(priv, SPI_ADRS_HOST_INT_ACK,
+		      cpu_to_le32(SPI_HOST_INT_UPDATE | BIT(29)));
+}
