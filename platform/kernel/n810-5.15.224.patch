+static int framebuffer_detect(struct panel_drv_data *ddata)
+{
+	struct omap_dss_device *dssdev = ddata->in;
+	u8 rev, conf;
+
+        if (!(blizzard_read_reg(dssdev,BLIZZARD_PLL_DIV) & 0x80)) {
+		dev_info(dssdev->dev, "LCD controller stopped; restarting\n");
+        }
+
+        rev = blizzard_read_reg(dssdev, BLIZZARD_REV_CODE);
+        conf = blizzard_read_reg(dssdev, BLIZZARD_CONFIG);
+
+        switch (rev & 0xfc) {
+        case 0x9c:
+                ddata->blizzard_ver = BLIZZARD_VERSION_S1D13744;
+                dev_info(dssdev->dev, "s1d13744 LCD controller rev %d "
+                        "initialized (CNF pins %x)\n", rev & 0x03, conf & 0x07);
+                break;
+        case 0xa4:
+                ddata->blizzard_ver = BLIZZARD_VERSION_S1D13745;
+                dev_info(dssdev->dev, "s1d13745 LCD controller rev %d "
+                        "initialized (CNF pins %x)\n", rev & 0x03, conf & 0x07);
+                break;
+        default:
+                dev_err(dssdev->dev, "invalid s1d1374x revision %02x\n", rev);
+                return -ENODEV;
+        }
+
+	return 0;
+}
+
+static int framebuffer_restart_sdram(struct panel_drv_data *ddata)
+{
+	struct omap_dss_device *dssdev = ddata->in;
+	unsigned long timeout = jiffies + msecs_to_jiffies(200);
+
+	blizzard_write_reg(dssdev, BLIZZARD_MEM_BANK0_ACTIVATE, 0);
+	udelay(50);
+	blizzard_write_reg(dssdev, BLIZZARD_MEM_BANK0_ACTIVATE, 1);
+
+	while (!(blizzard_read_reg(dssdev, BLIZZARD_MEM_BANK0_STATUS) & 0x01)) {
+		if (time_after(jiffies, timeout)) {
+			dev_err(dssdev->dev, "SDRAM did not become ready\n");
+			return -ETIMEDOUT;
+		}
+
+		usleep_range(1000, 2000);
+	}
+
+	return 0;
+}
+
+static int framebuffer_init(struct panel_drv_data *ddata)
+{
+	struct omap_dss_device *dssdev = ddata->in;
+	unsigned long timeout = jiffies + msecs_to_jiffies(1000);
+	u32 l;
+	int r;
+
+        l = blizzard_read_reg(dssdev, BLIZZARD_POWER_SAVE);
+        /* Standby, Sleep */
+        l &= ~0x03;
+        blizzard_write_reg(dssdev, BLIZZARD_POWER_SAVE, l);
+        l = blizzard_read_reg(dssdev, BLIZZARD_PLL_MODE);
+        l &= ~0x03;
+        /* Enable PLL, counter function */
+        l |= 0x1;
+        blizzard_write_reg(dssdev, BLIZZARD_PLL_MODE, l);
+
+	while (!(blizzard_read_reg(dssdev, BLIZZARD_PLL_DIV) & (1 << 7))) {
+		if (time_after(jiffies, timeout)) {
+			dev_err(dssdev->dev, "PLL did not lock\n");
+			return -ETIMEDOUT;
+		}
+
+		usleep_range(1000, 2000);
+	}
+
+	r = framebuffer_restart_sdram(ddata);
+	if (r)
+		return r;
+
+	/* Restore the geometry normally programmed by NOLO. */
+	blizzard_write_reg(dssdev, BLIZZARD_HDISP, 0x64);
+	blizzard_write_reg(dssdev, BLIZZARD_HNDP, 0x1e);
+	blizzard_write_reg(dssdev, BLIZZARD_VDISP0, 0xe0);
+	blizzard_write_reg(dssdev, BLIZZARD_VDISP1, 0x01);
+	blizzard_write_reg(dssdev, BLIZZARD_VNDP, 0x06);
+	blizzard_write_reg(dssdev, BLIZZARD_DISPLAY_MODE, 0x01);
+
+	return 0;
+}
