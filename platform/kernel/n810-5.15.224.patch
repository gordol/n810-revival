+static inline void blizzard_read(struct omap_dss_device *dssdev, u8 cmd, u8 *buf, int len)
+{
+        dssdev->ops.rfbi->write_command(dssdev, &cmd, 1);
+        dssdev->ops.rfbi->read_data(dssdev, buf, len);
