diff --git a/drivers/power/supply/n8x0_battery.c b/drivers/power/supply/n8x0_battery.c
new file mode 100644
index 0000000000000000000000000000000000000000..c7d42d2693eaded2f47bc8b01cf043bb189396d6
--- /dev/null
+++ b/drivers/power/supply/n8x0_battery.c
@@ -0,0 +1,231 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Nokia N800 (RX-34), N810 (RX-44) and N810 WiMax (RX-48) battery driver
+ *
+ * Copyright (C) 2021  Peter Vasil <petervasil@gmail.com>
+ */
+
+#include <linux/module.h>
+#include <linux/param.h>
+#include <linux/platform_device.h>
+#include <linux/power_supply.h>
+#include <linux/slab.h>
+#include <linux/iio/consumer.h>
+#include <linux/of.h>
+
+struct n8x0_device_info {
+	struct device *dev;
+	struct power_supply *bat;
+	struct power_supply_desc bat_desc;
+	struct iio_channel *channel_temp;
+	struct iio_channel *channel_bsi;
+	struct iio_channel *channel_vbat;
+};
+
+/*
+ * Read raw Retu MADC channel value
+ */
+static int n8x0_battery_read_adc(struct iio_channel *channel)
+{
+	int val, err;
+	err = iio_read_channel_raw(channel, &val);
+	if (err < 0)
+		return err;
+	return val;
+}
+
+/*
+ * Read Retu MADC channel 8 (BATVOLT) and convert to microVolts
+ * conversion equation taken from openwrt/omap24xx/linux-3.3/n810bm patch
+ */
+static int n8x0_battery_read_voltage(struct n8x0_device_info *di)
+{
+	int voltage = n8x0_battery_read_adc(di->channel_vbat);
+
+	if (voltage < 0) {
+		dev_err(di->dev, "Could not read ADC: %d\n", voltage);
+		return voltage;
+	}
+
+	if (voltage <= 0x37)
+		return 2800000;
+	else
+		return 2800000 + ( (voltage - 0x37) * (4200 - 2800) * 1000 / (0x236 - 0x37) );
+}
+
+/*
+ * Read Retu MADC channel 2 (BATTEMP) and convert value to tenths of Celsius
+ * FIXME: this conversion is not even extrapolated, just plainly made up :-)
+ * ~measured linear mapping: 300->20dC ; 250->30dC ; 200->40dC
+ * -> 500-> -20dC ... 0->80dC - probably wrong, but acceptable for now
+ */
+static int n8x0_battery_read_temperature(struct n8x0_device_info *di)
+{
+	int raw = n8x0_battery_read_adc(di->channel_temp);
+
+	if (raw < 0)
+		dev_err(di->dev, "Could not read ADC: %d\n", raw);
+
+	/* Zero and negative values are undefined */
+	if (raw <= 0)
+		return INT_MAX;
+
+	/* ADC channels are 10 bit, higher value are undefined */
+	if (raw >= (1 << 10))
+		return INT_MIN;
+
+	return 800 - (raw * 200)/100;
+}
+
+/*
+ * Read Retu MADC channel 1 (BSI) and convert RAW value to micro Ah
+ * This conversion formula was "inferred from revealed self-evident wisdom
+ * and extrapolated from associated sources" :-)
+ */
+static int n8x0_battery_read_capacity(struct n8x0_device_info *di)
+{
+	int capacity = n8x0_battery_read_adc(di->channel_bsi);
+
+	if (capacity < 0) {
+		dev_err(di->dev, "Could not read ADC: %d\n", capacity);
+		return capacity;
+	}
+
+	if (capacity <= 416) return 0;
+	return (capacity - 416) * 229 * 12;
+}
+
+/*
+ * Return power_supply property
+ */
+static int n8x0_battery_get_property(struct power_supply *psy,
+					enum power_supply_property psp,
+					union power_supply_propval *val)
+{
+	struct n8x0_device_info *di = power_supply_get_drvdata(psy);
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_TECHNOLOGY:
+		val->intval = POWER_SUPPLY_TECHNOLOGY_LION;
+		break;
+	case POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN:
+		val->intval = 4200000;
+		break;
+	case POWER_SUPPLY_PROP_PRESENT:
+		// FIXME: this should be obtained from Tahvo Status register
+		// but the device does not work at all without battery, so...
+		val->intval = n8x0_battery_read_voltage(di) ? 1 : 0;
+		break;
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+		val->intval = n8x0_battery_read_voltage(di);
+		break;
+	case POWER_SUPPLY_PROP_TEMP:
+		val->intval = n8x0_battery_read_temperature(di);
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN:
+		val->intval = n8x0_battery_read_capacity(di);
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	if (val->intval == INT_MAX || val->intval == INT_MIN)
+		return -EINVAL;
+
+	return 0;
+}
+
+static enum power_supply_property n8x0_battery_props[] = {
+	POWER_SUPPLY_PROP_TECHNOLOGY,
+	POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN,
+	POWER_SUPPLY_PROP_PRESENT,
+	POWER_SUPPLY_PROP_VOLTAGE_NOW,
+	POWER_SUPPLY_PROP_TEMP,
+	POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN,
+};
+
+static int n8x0_battery_probe(struct platform_device *pdev)
+{
+	struct power_supply_config psy_cfg = {};
+	struct n8x0_device_info *di;
+	int ret;
+
+	di = devm_kzalloc(&pdev->dev, sizeof(*di), GFP_KERNEL);
+	if (!di)
+		return -ENOMEM;
+
+	platform_set_drvdata(pdev, di);
+
+	di->dev = &pdev->dev;
+	di->bat_desc.name = "n8x0-battery";
+	di->bat_desc.type = POWER_SUPPLY_TYPE_BATTERY;
+	di->bat_desc.properties = n8x0_battery_props;
+	di->bat_desc.num_properties = ARRAY_SIZE(n8x0_battery_props);
+	di->bat_desc.get_property = n8x0_battery_get_property;
+
+	psy_cfg.drv_data = di;
+
+	di->channel_temp = devm_iio_channel_get(di->dev, "temp");
+	if (IS_ERR(di->channel_temp)) {
+		if (PTR_ERR(di->channel_temp) == -ENODEV)
+			return -EPROBE_DEFER;
+		return PTR_ERR(di->channel_temp);
+	}
+
+	di->channel_bsi  = devm_iio_channel_get(di->dev, "bsi");
+	if (IS_ERR(di->channel_bsi)) {
+		if (PTR_ERR(di->channel_bsi) == -ENODEV)
+			return -EPROBE_DEFER;
+		return PTR_ERR(di->channel_bsi);
+	}
+
+	di->channel_vbat = devm_iio_channel_get(di->dev, "vbat");
+	if (IS_ERR(di->channel_vbat)) {
+		if (PTR_ERR(di->channel_vbat) == -ENODEV)
+			return -EPROBE_DEFER;
+		return PTR_ERR(di->channel_vbat);
+	}
+
+	di->bat = power_supply_register(di->dev, &di->bat_desc, &psy_cfg);
+	if (IS_ERR(di->bat)) {
+		return PTR_ERR(di->bat);
+	}
+
+	return 0;
+}
+
+static int n8x0_battery_remove(struct platform_device *pdev)
+{
+	struct n8x0_device_info *di = platform_get_drvdata(pdev);
+
+	power_supply_unregister(di->bat);
+
+	iio_channel_release(di->channel_vbat);
+	iio_channel_release(di->channel_bsi);
+	iio_channel_release(di->channel_temp);
+
+	return 0;
+}
+
+#ifdef CONFIG_OF
+static const struct of_device_id n8x0_battery_of_match[] = {
+	{.compatible = "nokia,n8x0-battery", },
+	{ },
+};
+MODULE_DEVICE_TABLE(of, n8x0_battery_of_match);
+#endif
+
+static struct platform_driver n8x0_battery_driver = {
+	.probe = n8x0_battery_probe,
+	.remove = n8x0_battery_remove,
+	.driver = {
+		.name = "n8x0-battery",
+		.of_match_table = of_match_ptr(n8x0_battery_of_match),
+	},
+};
+module_platform_driver(n8x0_battery_driver);
+
+MODULE_ALIAS("platform:n8x0-battery");
+MODULE_AUTHOR("Peter Vasil <petervasil@gmail.com");
+MODULE_DESCRIPTION("Nokia N8x0 battery driver");
+MODULE_LICENSE("GPL");
diff --git a/drivers/power/supply/tahvo_charger.c b/drivers/power/supply/tahvo_charger.c
new file mode 100644
index 0000000000000000000000000000000000000000..ec1b7a6d2be40df3b81eb04c3106f98058ed33dc
--- /dev/null
+++ b/drivers/power/supply/tahvo_charger.c
@@ -0,0 +1,628 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/* Conservative charger and battery management for Nokia N8x0 Tahvo PMICs. */
+
+#include <linux/delay.h>
+#include <linux/iio/consumer.h>
+#include <linux/interrupt.h>
+#include <linux/jiffies.h>
+#include <linux/mfd/retu.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/power_supply.h>
+#include <linux/workqueue.h>
+
+#define TAHVO_REG_CHGCURR             0x04
+#define TAHVO_REG_CHGCTL              0x08
+#define TAHVO_REG_BATCURRTIMER        0x0c
+#define TAHVO_REG_BATCURR             0x0d
+#define TAHVO_CHGCTL_EN               BIT(0)
+#define TAHVO_CHGCTL_PWMOVR           BIT(2)
+#define TAHVO_CHGCTL_PWMOVRZERO       BIT(3)
+#define TAHVO_CHGCTL_CURMEAS          BIT(6)
+#define TAHVO_CHGCTL_CURTIMRST        BIT(7)
+#define TAHVO_CHGCTL_CHARGE_MASK      (TAHVO_CHGCTL_EN | TAHVO_CHGCTL_PWMOVR | \
+				       TAHVO_CHGCTL_PWMOVRZERO | TAHVO_CHGCTL_CURMEAS)
+
+/* Maemo was observed charging steadily at PWM 240. */
+#define TAHVO_CHARGE_PWM              240
+#define TAHVO_MAX_CURRENT_UA          550000
+#define TAHVO_HARD_LIMIT_UV           4200000
+#define TAHVO_DEFAULT_START_PERCENT   55
+#define TAHVO_DEFAULT_END_PERCENT     80
+#define TAHVO_MIN_TEMP_DECIC          50
+#define TAHVO_MAX_TEMP_DECIC          450
+#define TAHVO_FULL_SAMPLES            4
+#define TAHVO_RECOVERY_SAMPLES        60
+#define TAHVO_MONITOR_MS              1000
+#define TAHVO_IRQ_TIMEOUT_MS          2000
+#define TAHVO_MAX_SESSION_SEC         (4 * 60 * 60)
+
+struct tahvo_charger {
+	struct device *dev;
+	struct retu_dev *rdev;
+	struct iio_channel *vchg, *bsi, *temp, *vbat;
+	struct power_supply *charger, *battery;
+	struct delayed_work monitor_work;
+	struct mutex lock;
+	unsigned long last_irq, session_start;
+	int voltage_uv, current_ua, temp_decic;
+	int charge_full_design_uah, capacity, fault;
+	u8 pwm, requested_pwm, full_samples;
+	u8 start_threshold, end_threshold;
+	u16 recovery_samples;
+	bool online, charging, full, enabled, stopping;
+};
+
+static int tahvo_read_raw(struct iio_channel *channel)
+{
+	int raw, ret = iio_read_channel_raw(channel, &raw);
+
+	return ret < 0 ? ret : raw;
+}
+
+static int tahvo_read_average(struct iio_channel *channel, unsigned int count)
+{
+	int raw, sum = 0;
+	unsigned int i;
+
+	for (i = 0; i < count; i++) {
+		raw = tahvo_read_raw(channel);
+		if (raw < 0)
+			return raw;
+		sum += raw;
+	}
+	return DIV_ROUND_CLOSEST(sum, count);
+}
+
+static int tahvo_raw_to_uv(int raw)
+{
+	if (raw <= 0x37)
+		return 2800000;
+	return 2800000 + (raw - 0x37) * 1400000 / (0x236 - 0x37);
+}
+
+static int tahvo_raw_to_temp(int raw)
+{
+	if (raw <= 0 || raw >= 1024)
+		return -EINVAL;
+	return 800 - raw * 2;
+}
+
+static int tahvo_capacity_from_uv(int uv)
+{
+	/* Historical N810 mapping: 3.70 V empty, 4.15 V full. */
+	return clamp((uv - 3700000) * 100 / 450000, 0, 100);
+}
+
+static int tahvo_threshold_to_uv(int percent)
+{
+	return 3700000 + percent * 4500;
+}
+
+static int tahvo_charger_online(struct tahvo_charger *chg)
+{
+	int raw = tahvo_read_raw(chg->vchg);
+
+	return raw < 0 ? raw : raw > 0;
+}
+
+static int tahvo_update_measurements(struct tahvo_charger *chg)
+{
+	int raw = tahvo_read_average(chg->vbat, 5);
+
+	if (raw < 0)
+		return raw;
+	chg->voltage_uv = tahvo_raw_to_uv(raw);
+	chg->capacity = tahvo_capacity_from_uv(chg->voltage_uv);
+	raw = tahvo_read_average(chg->temp, 5);
+	if (raw < 0)
+		return raw;
+	chg->temp_decic = tahvo_raw_to_temp(raw);
+	return chg->temp_decic < 0 ? chg->temp_decic : 0;
+}
+
+static int tahvo_maskset(struct tahvo_charger *chg, u16 mask, u16 value)
+{
+	int control = retu_read(chg->rdev, TAHVO_REG_CHGCTL);
+
+	if (control < 0)
+		return control;
+	return retu_write(chg->rdev, TAHVO_REG_CHGCTL,
+			  (control & ~mask) | (value & mask));
+}
+
+static int tahvo_timer_set(struct tahvo_charger *chg, u8 value)
+{
+	int ret = retu_write(chg->rdev, TAHVO_REG_BATCURRTIMER, value);
+
+	if (ret < 0)
+		return ret;
+	ret = tahvo_maskset(chg, TAHVO_CHGCTL_CURTIMRST,
+			    TAHVO_CHGCTL_CURTIMRST);
+	if (ret < 0)
+		return ret;
+	return tahvo_maskset(chg, TAHVO_CHGCTL_CURTIMRST, 0);
+}
+
+static int tahvo_stop_locked(struct tahvo_charger *chg, bool full, int fault)
+{
+	bool was_charging = chg->charging;
+	int ret, ret2;
+
+	ret = retu_write(chg->rdev, TAHVO_REG_CHGCURR, 0);
+	ret2 = tahvo_timer_set(chg, 0);
+	if (!ret && ret2 < 0)
+		ret = ret2;
+	ret2 = tahvo_maskset(chg, TAHVO_CHGCTL_CHARGE_MASK,
+			     TAHVO_CHGCTL_EN | TAHVO_CHGCTL_PWMOVR |
+			     TAHVO_CHGCTL_PWMOVRZERO);
+	if (!ret && ret2 < 0)
+		ret = ret2;
+	chg->pwm = 0;
+	chg->current_ua = 0;
+	chg->charging = false;
+	chg->full = full;
+	chg->fault = fault ? fault : min(ret, 0);
+	chg->full_samples = 0;
+	chg->recovery_samples = 0;
+	if (was_charging) {
+		if (chg->fault)
+			dev_warn(chg->dev, "charging stopped: fault %d\n",
+				 chg->fault);
+		else if (full)
+			dev_info(chg->dev, "charging complete at %d mV\n",
+				 chg->voltage_uv / 1000);
+		else
+			dev_info(chg->dev, "charging stopped\n");
+	}
+	return ret;
+}
+
+static int tahvo_start_locked(struct tahvo_charger *chg)
+{
+	int ret = retu_write(chg->rdev, TAHVO_REG_CHGCURR,
+			     chg->requested_pwm);
+
+	if (ret < 0)
+		return ret;
+	ret = tahvo_maskset(chg, TAHVO_CHGCTL_CHARGE_MASK,
+			    TAHVO_CHGCTL_EN | TAHVO_CHGCTL_CURMEAS);
+	if (ret < 0)
+		goto fail;
+	/* A timer value of one is approximately 250 ms on Tahvo. */
+	ret = tahvo_timer_set(chg, 1);
+	if (ret < 0)
+		goto fail;
+	chg->pwm = chg->requested_pwm;
+	chg->charging = true;
+	chg->full = false;
+	chg->fault = 0;
+	chg->full_samples = 0;
+	chg->last_irq = chg->session_start = jiffies;
+	dev_info(chg->dev, "charging started: PWM %u, band %u-%u%%\n",
+		 chg->pwm, chg->start_threshold, chg->end_threshold);
+	return 0;
+fail:
+	tahvo_stop_locked(chg, false, ret);
+	return ret;
+}
+
+static void tahvo_notify(struct tahvo_charger *chg)
+{
+	if (chg->charger)
+		power_supply_changed(chg->charger);
+	if (chg->battery)
+		power_supply_changed(chg->battery);
+}
+
+static irqreturn_t tahvo_batcurr_irq_thread(int irq, void *data)
+{
+	struct tahvo_charger *chg = data;
+	int raw, i, sum = 0, ret;
+
+	mutex_lock(&chg->lock);
+	if (!chg->charging)
+		goto out;
+	ret = tahvo_maskset(chg, TAHVO_CHGCTL_PWMOVR |
+				 TAHVO_CHGCTL_PWMOVRZERO, TAHVO_CHGCTL_PWMOVR);
+	if (ret < 0)
+		goto fault;
+	usleep_range(2000, 3000);
+	for (i = 0; i < 3; i++) {
+		raw = retu_read(chg->rdev, TAHVO_REG_BATCURR);
+		if (raw < 0) {
+			ret = raw;
+			goto fault;
+		}
+		sum += (s16)raw;
+	}
+	/* Provisional conversion: measured current is about raw / 3 mA. */
+	chg->current_ua = DIV_ROUND_CLOSEST(sum, 9) * 1000;
+	ret = tahvo_maskset(chg, TAHVO_CHGCTL_PWMOVR |
+				 TAHVO_CHGCTL_PWMOVRZERO,
+				 TAHVO_CHGCTL_PWMOVR | TAHVO_CHGCTL_PWMOVRZERO);
+	if (ret < 0)
+		goto fault;
+	usleep_range(10000, 12000);
+	ret = tahvo_update_measurements(chg);
+	if (ret < 0)
+		goto fault;
+	chg->last_irq = jiffies;
+	if (chg->current_ua > TAHVO_MAX_CURRENT_UA ||
+	    chg->temp_decic < TAHVO_MIN_TEMP_DECIC ||
+	    chg->temp_decic > TAHVO_MAX_TEMP_DECIC ||
+	    chg->voltage_uv >= TAHVO_HARD_LIMIT_UV) {
+		ret = -ERANGE;
+		goto fault;
+	}
+	if (chg->voltage_uv >= tahvo_threshold_to_uv(chg->end_threshold))
+		chg->full_samples++;
+	else
+		chg->full_samples = 0;
+	if (chg->full_samples >= TAHVO_FULL_SAMPLES) {
+		tahvo_stop_locked(chg, true, 0);
+		goto notify;
+	}
+	ret = tahvo_maskset(chg, TAHVO_CHGCTL_PWMOVR |
+				 TAHVO_CHGCTL_PWMOVRZERO, 0);
+	if (ret < 0)
+		goto fault;
+	goto out;
+fault:
+	tahvo_stop_locked(chg, false, ret);
+notify:
+	tahvo_notify(chg);
+out:
+	mutex_unlock(&chg->lock);
+	return IRQ_HANDLED;
+}
+
+static void tahvo_monitor_work(struct work_struct *work)
+{
+	struct tahvo_charger *chg = container_of(to_delayed_work(work),
+						 struct tahvo_charger, monitor_work);
+	bool was_charging, was_full, was_online;
+	int was_fault;
+	int online, ret = 0;
+
+	mutex_lock(&chg->lock);
+	was_charging = chg->charging;
+	was_full = chg->full;
+	was_online = chg->online;
+	was_fault = chg->fault;
+	online = tahvo_charger_online(chg);
+	if (online < 0) {
+		if (chg->charging)
+			tahvo_stop_locked(chg, false, online);
+		goto out;
+	}
+	chg->online = online;
+	if (chg->charging) {
+		if (!online)
+			ret = tahvo_stop_locked(chg, false, 0);
+		else if (time_after(jiffies, chg->last_irq +
+				    msecs_to_jiffies(TAHVO_IRQ_TIMEOUT_MS)))
+			ret = tahvo_stop_locked(chg, false, -ETIMEDOUT);
+		else if (time_after(jiffies, chg->session_start +
+				    TAHVO_MAX_SESSION_SEC * HZ))
+			ret = tahvo_stop_locked(chg, false, -ETIME);
+	} else {
+		ret = tahvo_update_measurements(chg);
+		if (!online) {
+			chg->full = false;
+			chg->fault = 0;
+			chg->recovery_samples = 0;
+		} else if (!ret && chg->enabled &&
+			   chg->voltage_uv <
+			   tahvo_threshold_to_uv(chg->start_threshold) &&
+			   chg->temp_decic >= TAHVO_MIN_TEMP_DECIC &&
+			   chg->temp_decic <= TAHVO_MAX_TEMP_DECIC) {
+			if (!chg->fault || ++chg->recovery_samples >=
+			    TAHVO_RECOVERY_SAMPLES) {
+				chg->fault = 0;
+				chg->recovery_samples = 0;
+				ret = tahvo_start_locked(chg);
+			}
+		} else {
+			chg->recovery_samples = 0;
+		}
+	}
+out:
+	if (ret < 0)
+		dev_warn_ratelimited(chg->dev, "charger policy stopped: %d\n", ret);
+	if (was_charging != chg->charging || was_full != chg->full ||
+	    was_online != chg->online || was_fault != chg->fault)
+		tahvo_notify(chg);
+	mutex_unlock(&chg->lock);
+	if (!READ_ONCE(chg->stopping))
+		schedule_delayed_work(&chg->monitor_work,
+				      msecs_to_jiffies(TAHVO_MONITOR_MS));
+}
+
+static enum power_supply_property tahvo_charger_props[] = {
+	POWER_SUPPLY_PROP_ONLINE, POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_CHARGE_CONTROL_LIMIT,
+	POWER_SUPPLY_PROP_CHARGE_CONTROL_LIMIT_MAX,
+	POWER_SUPPLY_PROP_CHARGE_CONTROL_START_THRESHOLD,
+	POWER_SUPPLY_PROP_CHARGE_CONTROL_END_THRESHOLD,
+};
+
+static int tahvo_charger_get_property(struct power_supply *psy,
+				      enum power_supply_property prop,
+				      union power_supply_propval *val)
+{
+	struct tahvo_charger *chg = power_supply_get_drvdata(psy);
+
+	switch (prop) {
+	case POWER_SUPPLY_PROP_ONLINE:
+		val->intval = READ_ONCE(chg->online); break;
+	case POWER_SUPPLY_PROP_STATUS:
+		val->intval = READ_ONCE(chg->charging) ?
+			POWER_SUPPLY_STATUS_CHARGING : POWER_SUPPLY_STATUS_NOT_CHARGING;
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_CONTROL_LIMIT:
+		val->intval = READ_ONCE(chg->enabled) ?
+			READ_ONCE(chg->requested_pwm) : 0;
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_CONTROL_LIMIT_MAX:
+		val->intval = TAHVO_CHARGE_PWM; break;
+	case POWER_SUPPLY_PROP_CHARGE_CONTROL_START_THRESHOLD:
+		val->intval = READ_ONCE(chg->start_threshold); break;
+	case POWER_SUPPLY_PROP_CHARGE_CONTROL_END_THRESHOLD:
+		val->intval = READ_ONCE(chg->end_threshold); break;
+	default:
+		return -EINVAL;
+	}
+	return 0;
+}
+
+static int tahvo_charger_set_property(struct power_supply *psy,
+				      enum power_supply_property prop,
+				      const union power_supply_propval *val)
+{
+	struct tahvo_charger *chg = power_supply_get_drvdata(psy);
+	bool charging_changed, was_charging;
+	int ret = 0;
+
+	mutex_lock(&chg->lock);
+	was_charging = chg->charging;
+	switch (prop) {
+	case POWER_SUPPLY_PROP_CHARGE_CONTROL_LIMIT:
+		if (val->intval < 0 || val->intval > TAHVO_CHARGE_PWM) {
+			ret = -EINVAL;
+			break;
+		}
+		if (!val->intval) {
+			chg->enabled = false;
+			ret = tahvo_stop_locked(chg, false, 0);
+		} else {
+			chg->requested_pwm = val->intval;
+			chg->enabled = true;
+			if (chg->charging) {
+				ret = retu_write(chg->rdev, TAHVO_REG_CHGCURR,
+						 chg->requested_pwm);
+				if (ret < 0)
+					tahvo_stop_locked(chg, false, ret);
+				else
+					chg->pwm = chg->requested_pwm;
+			}
+			if (!ret)
+				dev_info(chg->dev, "PWM limit set to %u\n",
+					 chg->requested_pwm);
+		}
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_CONTROL_START_THRESHOLD:
+		if (val->intval < 20 || val->intval >= chg->end_threshold)
+			ret = -EINVAL;
+		else {
+			chg->start_threshold = val->intval;
+			dev_info(chg->dev, "start threshold set to %u%%\n",
+				 chg->start_threshold);
+		}
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_CONTROL_END_THRESHOLD:
+		if (val->intval <= chg->start_threshold || val->intval > 100)
+			ret = -EINVAL;
+		else {
+			chg->end_threshold = val->intval;
+			dev_info(chg->dev, "end threshold set to %u%%\n",
+				 chg->end_threshold);
+		}
+		break;
+	default:
+		ret = -EINVAL;
+	}
+	charging_changed = was_charging != chg->charging;
+	mutex_unlock(&chg->lock);
+	if (charging_changed)
+		tahvo_notify(chg);
+	return ret;
+}
+
+static int tahvo_charger_property_is_writeable(struct power_supply *psy,
+					       enum power_supply_property prop)
+{
+	return prop == POWER_SUPPLY_PROP_CHARGE_CONTROL_LIMIT ||
+		prop == POWER_SUPPLY_PROP_CHARGE_CONTROL_START_THRESHOLD ||
+		prop == POWER_SUPPLY_PROP_CHARGE_CONTROL_END_THRESHOLD;
+}
+
+static const struct power_supply_desc tahvo_charger_desc = {
+	.name = "tahvo-charger", .type = POWER_SUPPLY_TYPE_MAINS,
+	.properties = tahvo_charger_props,
+	.num_properties = ARRAY_SIZE(tahvo_charger_props),
+	.get_property = tahvo_charger_get_property,
+	.set_property = tahvo_charger_set_property,
+	.property_is_writeable = tahvo_charger_property_is_writeable,
+};
+
+static enum power_supply_property tahvo_battery_props[] = {
+	POWER_SUPPLY_PROP_STATUS, POWER_SUPPLY_PROP_HEALTH,
+	POWER_SUPPLY_PROP_PRESENT, POWER_SUPPLY_PROP_TECHNOLOGY,
+	POWER_SUPPLY_PROP_VOLTAGE_NOW, POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN,
+	POWER_SUPPLY_PROP_CURRENT_NOW, POWER_SUPPLY_PROP_TEMP,
+	POWER_SUPPLY_PROP_CAPACITY, POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN,
+	POWER_SUPPLY_PROP_MODEL_NAME,
+};
+
+static int tahvo_battery_get_property(struct power_supply *psy,
+				      enum power_supply_property prop,
+				      union power_supply_propval *val)
+{
+	struct tahvo_charger *chg = power_supply_get_drvdata(psy);
+
+	switch (prop) {
+	case POWER_SUPPLY_PROP_STATUS:
+		if (READ_ONCE(chg->charging))
+			val->intval = POWER_SUPPLY_STATUS_CHARGING;
+		else if (READ_ONCE(chg->full) && READ_ONCE(chg->online))
+			val->intval = POWER_SUPPLY_STATUS_FULL;
+		else if (READ_ONCE(chg->online))
+			val->intval = POWER_SUPPLY_STATUS_NOT_CHARGING;
+		else
+			val->intval = POWER_SUPPLY_STATUS_DISCHARGING;
+		break;
+	case POWER_SUPPLY_PROP_HEALTH:
+		if (READ_ONCE(chg->temp_decic) > TAHVO_MAX_TEMP_DECIC)
+			val->intval = POWER_SUPPLY_HEALTH_OVERHEAT;
+		else if (READ_ONCE(chg->temp_decic) < TAHVO_MIN_TEMP_DECIC)
+			val->intval = POWER_SUPPLY_HEALTH_COLD;
+		else if (READ_ONCE(chg->fault))
+			val->intval = POWER_SUPPLY_HEALTH_UNSPEC_FAILURE;
+		else
+			val->intval = POWER_SUPPLY_HEALTH_GOOD;
+		break;
+	case POWER_SUPPLY_PROP_PRESENT:
+		val->intval = 1; break;
+	case POWER_SUPPLY_PROP_TECHNOLOGY:
+		val->intval = POWER_SUPPLY_TECHNOLOGY_LION; break;
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+		val->intval = READ_ONCE(chg->voltage_uv); break;
+	case POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN:
+		val->intval = TAHVO_HARD_LIMIT_UV; break;
+	case POWER_SUPPLY_PROP_CURRENT_NOW:
+		val->intval = READ_ONCE(chg->current_ua); break;
+	case POWER_SUPPLY_PROP_TEMP:
+		val->intval = READ_ONCE(chg->temp_decic); break;
+	case POWER_SUPPLY_PROP_CAPACITY:
+		val->intval = READ_ONCE(chg->capacity); break;
+	case POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN:
+		val->intval = READ_ONCE(chg->charge_full_design_uah); break;
+	case POWER_SUPPLY_PROP_MODEL_NAME:
+		val->strval = "Nokia BP-4L"; break;
+	default:
+		return -EINVAL;
+	}
+	return 0;
+}
+
+static const struct power_supply_desc tahvo_battery_desc = {
+	.name = "n8x0-battery", .type = POWER_SUPPLY_TYPE_BATTERY,
+	.properties = tahvo_battery_props,
+	.num_properties = ARRAY_SIZE(tahvo_battery_props),
+	.get_property = tahvo_battery_get_property,
+};
+
+static int tahvo_charger_probe(struct platform_device *pdev)
+{
+	struct power_supply_config cfg = {};
+	struct tahvo_charger *chg;
+	int bsi, irq, ret;
+
+	chg = devm_kzalloc(&pdev->dev, sizeof(*chg), GFP_KERNEL);
+	if (!chg)
+		return -ENOMEM;
+	chg->dev = &pdev->dev;
+	chg->rdev = dev_get_drvdata(pdev->dev.parent);
+	chg->requested_pwm = TAHVO_CHARGE_PWM;
+	chg->start_threshold = TAHVO_DEFAULT_START_PERCENT;
+	chg->end_threshold = TAHVO_DEFAULT_END_PERCENT;
+	chg->enabled = true;
+	chg->vchg = devm_iio_channel_get(&pdev->dev, "vchg");
+	if (IS_ERR(chg->vchg))
+		return dev_err_probe(&pdev->dev, PTR_ERR(chg->vchg), "vchg ADC\n");
+	chg->bsi = devm_iio_channel_get(&pdev->dev, "bsi");
+	if (IS_ERR(chg->bsi))
+		return dev_err_probe(&pdev->dev, PTR_ERR(chg->bsi), "BSI ADC\n");
+	chg->temp = devm_iio_channel_get(&pdev->dev, "temp");
+	if (IS_ERR(chg->temp))
+		return dev_err_probe(&pdev->dev, PTR_ERR(chg->temp), "temp ADC\n");
+	chg->vbat = devm_iio_channel_get(&pdev->dev, "vbat");
+	if (IS_ERR(chg->vbat))
+		return dev_err_probe(&pdev->dev, PTR_ERR(chg->vbat), "vbat ADC\n");
+	mutex_init(&chg->lock);
+	INIT_DELAYED_WORK(&chg->monitor_work, tahvo_monitor_work);
+	platform_set_drvdata(pdev, chg);
+	ret = tahvo_stop_locked(chg, false, 0);
+	if (ret < 0)
+		return dev_err_probe(&pdev->dev, ret, "failed to force charger off\n");
+	ret = tahvo_update_measurements(chg);
+	if (ret < 0)
+		return dev_err_probe(&pdev->dev, ret, "battery ADC\n");
+	bsi = tahvo_read_average(chg->bsi, 5);
+	chg->charge_full_design_uah =
+		(bsi >= 0x3b5 - 20 && bsi <= 0x3b5 + 20) ? 1500000 : 0;
+	ret = tahvo_charger_online(chg);
+	if (ret < 0)
+		return ret;
+	chg->online = ret;
+	irq = platform_get_irq_byname(pdev, "tahvo-batcurr");
+	if (irq < 0)
+		return irq;
+	ret = devm_request_threaded_irq(&pdev->dev, irq, NULL,
+					tahvo_batcurr_irq_thread, IRQF_ONESHOT,
+					dev_name(&pdev->dev), chg);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret, "battery-current IRQ\n");
+	cfg.drv_data = chg;
+	cfg.of_node = pdev->dev.of_node;
+	chg->charger = devm_power_supply_register(&pdev->dev,
+						  &tahvo_charger_desc, &cfg);
+	if (IS_ERR(chg->charger))
+		return PTR_ERR(chg->charger);
+	chg->battery = devm_power_supply_register(&pdev->dev,
+						  &tahvo_battery_desc, &cfg);
+	if (IS_ERR(chg->battery))
+		return PTR_ERR(chg->battery);
+	schedule_delayed_work(&chg->monitor_work, 0);
+	dev_info(&pdev->dev, "safe autonomous charging enabled\n");
+	return 0;
+}
+
+static int tahvo_charger_remove(struct platform_device *pdev)
+{
+	struct tahvo_charger *chg = platform_get_drvdata(pdev);
+
+	WRITE_ONCE(chg->stopping, true);
+	cancel_delayed_work_sync(&chg->monitor_work);
+	mutex_lock(&chg->lock);
+	tahvo_stop_locked(chg, false, 0);
+	mutex_unlock(&chg->lock);
+	return 0;
+}
+
+static void tahvo_charger_shutdown(struct platform_device *pdev)
+{
+	tahvo_charger_remove(pdev);
+}
+
+static const struct of_device_id tahvo_charger_of_match[] = {
+	{ .compatible = "nokia,tahvo-charger" }, { }
+};
+MODULE_DEVICE_TABLE(of, tahvo_charger_of_match);
+
+static struct platform_driver tahvo_charger_driver = {
+	.probe = tahvo_charger_probe,
+	.remove = tahvo_charger_remove,
+	.shutdown = tahvo_charger_shutdown,
+	.driver = {
+		.name = "tahvo-charger",
+		.of_match_table = tahvo_charger_of_match,
+	},
+};
+module_platform_driver(tahvo_charger_driver);
+
+MODULE_DESCRIPTION("Nokia N8x0 Tahvo charger and battery management");
+MODULE_LICENSE("GPL");
