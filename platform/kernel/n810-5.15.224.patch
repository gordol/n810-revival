+static bool fbcon_rgb_supported(struct vc_data *vc, struct fb_info *info)
+{
+	return vc->vc_rgb && info->pseudo_palette &&
+		info->fix.visual == FB_VISUAL_TRUECOLOR &&
+		info->var.bits_per_pixel >= 15 &&
+		info->var.red.length && info->var.red.length <= 8 &&
