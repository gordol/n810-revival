[Unit]
Description=Set up the N810 touchscreen on first boot
Wants=systemd-udev-settle.service
After=systemd-user-sessions.service systemd-udev-settle.service ssh.service
Before=getty@tty1.service
ConditionPathExists=!/etc/n810/touch-calibration.json

[Service]
Type=oneshot
ExecStartPre=/usr/bin/chvt 1
ExecStartPre=/usr/bin/kbd_mode -u -C /dev/tty1
ExecStart=/usr/local/sbin/n810-setup-touch --first-boot
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TimeoutStartSec=320

[Install]
WantedBy=multi-user.target
