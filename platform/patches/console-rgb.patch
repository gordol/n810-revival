+static bool fbcon_rgb_supported(struct vc_data *vc, struct fb_info *info)
+{
+	return vc->vc_rgb && info->pseudo_palette &&
+		info->fix.visual == FB_VISUAL_TRUECOLOR &&
+		info->var.bits_per_pixel >= 15 &&
+		info->var.red.length && info->var.red.length <= 8 &&
+		info->var.green.length && info->var.green.length <= 8 &&
+		info->var.blue.length && info->var.blue.length <= 8;
+}
+
+static u32 fbcon_rgb_pixel(struct fb_info *info, u32 rgb)
+{
+	const struct fb_var_screeninfo *var = &info->var;
+	u32 r = (rgb >> 16) & 255, g = (rgb >> 8) & 255, b = rgb & 255;
+	u32 pixel;
+
+	pixel = (r >> (8 - var->red.length)) << var->red.offset;
+	pixel |= (g >> (8 - var->green.length)) << var->green.offset;
+	pixel |= (b >> (8 - var->blue.length)) << var->blue.offset;
+	if (var->transp.length && var->transp.length <= 8)
+		pixel |= ((1U << var->transp.length) - 1) << var->transp.offset;
+	return pixel;
+}
+
+static bool fbcon_rgb_putcs(struct vc_data *vc, struct fb_info *info,
+			   const unsigned short *s, int count, int y, int x)
+{
+	struct fbcon_display *display = &fb_display[vc->vc_num];
+	struct fbcon_ops *ops = info->fbcon_par;
+	u32 *palette = info->pseudo_palette;
+	u32 saved_fg, saved_bg;
+	int n, fg, bg;
+	struct vc_rgb color, next;
+
+	if (!fbcon_rgb_supported(vc, info) || y >= vc->vc_rows || x >= vc->vc_cols)
+		return false;
+	saved_fg = palette[14];
+	saved_bg = palette[15];
+	while (count > 0) {
+		color = vc_rgb_cell(vc, y, x);
+		for (n = 1; n < count && x + n < vc->vc_cols; n++) {
+			next = vc_rgb_cell(vc, y, x + n);
+			if (color.fg != next.fg || color.bg != next.bg ||
+			    (scr_readw(s) & 0xff00) != (scr_readw(s + n) & 0xff00))
+				break;
+		}
+		fg = get_color(vc, info, scr_readw(s), 1);
+		bg = get_color(vc, info, scr_readw(s), 0);
+		if (color.fg != VC_RGB_DEFAULT || color.bg != VC_RGB_DEFAULT) {
+			u32 fg_pixel = color.fg == VC_RGB_DEFAULT ? palette[fg] :
+				fbcon_rgb_pixel(info, color.fg);
+			u32 bg_pixel = color.bg == VC_RGB_DEFAULT ? palette[bg] :
+				fbcon_rgb_pixel(info, color.bg);
+
+			palette[14] = fg_pixel;
+			palette[15] = bg_pixel;
+			fg = 14;
+			bg = 15;
+		}
+		ops->putcs(vc, info, s, n, real_y(display, y), x, fg, bg);
+		palette[14] = saved_fg;
+		palette[15] = saved_bg;
+		s += n;
+		x += n;
+		count -= n;
+	}
+	return true;
+}
+
+static bool fbcon_rgb_clear(struct vc_data *vc, struct fb_info *info,
+			   int y, int x, int height, int width)
+{
+	struct fbcon_display *display = &fb_display[vc->vc_num];
+	struct vc_rgb color = vc_rgb_current(vc, true);
+	struct fb_fillrect region;
+	u32 *palette = info->pseudo_palette, saved;
+
+	if (!fbcon_rgb_supported(vc, info) || color.bg == VC_RGB_DEFAULT)
+		return false;
+	saved = palette[15];
+	palette[15] = fbcon_rgb_pixel(info, color.bg);
+	region.color = 15;
+	region.dx = x * vc->vc_font.width;
+	region.width = width * vc->vc_font.width;
+	region.height = vc->vc_font.height;
+	region.rop = ROP_COPY;
+	while (height--) {
+		region.dy = real_y(display, y++) * vc->vc_font.height;
+		info->fbops->fb_fillrect(info, &region);
+	}
+	palette[15] = saved;
+	return true;
+}
+
+static void fbcon_do_cursor(struct vc_data *vc, struct fb_info *info, int mode, int c)
+{
+	struct fbcon_ops *ops = info->fbcon_par;
+	struct vc_rgb color = vc_rgb_cell(vc, vc->state.y, vc->state.x);
+	u32 *palette = info->pseudo_palette, saved_fg = 0, saved_bg = 0;
+	int fg = get_color(vc, info, c, 1), bg = get_color(vc, info, c, 0);
+	bool rgb = fbcon_rgb_supported(vc, info);
+
+	if (rgb) {
+		saved_fg = palette[14];
+		saved_bg = palette[15];
+		if (color.fg != VC_RGB_DEFAULT || color.bg != VC_RGB_DEFAULT) {
+			u32 fg_pixel = color.fg == VC_RGB_DEFAULT ? palette[fg] :
+				fbcon_rgb_pixel(info, color.fg);
+			u32 bg_pixel = color.bg == VC_RGB_DEFAULT ? palette[bg] :
+				fbcon_rgb_pixel(info, color.bg);
+
+			palette[14] = fg_pixel;
+			palette[15] = bg_pixel;
+			fg = 14;
+			bg = 15;
+		}
+	}
+	ops->cursor(vc, info, mode, fg, bg);
+	if (rgb) {
+		palette[14] = saved_fg;
+		palette[15] = saved_bg;
+	}
+}
