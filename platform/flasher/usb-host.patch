+/* A capture is bound to one enumeration of the recorded physical port.
+ * Never wait for a replacement after that enumeration disappears. */
+const char *pocket_usb_instance;
+
+static int pocket_matches_instance(struct usb_device *dev) {
+    char token[64];
+    if (dev->descriptor.idVendor != 0x0421 || dev->descriptor.idProduct != 0x0105)
+        return 0;
+#ifdef __APPLE__
+    /* libusb-compat stores its libusb_device in dev->dev. Darwin uses
+     * the IORegistry sessionID as libusb session data. */
+    unsigned long (*session)(void *) = dlsym(RTLD_DEFAULT, "libusb_get_session_data");
+    if (!session || !dev->dev)
+        return 0;
+    snprintf(token, sizeof(token), "%lu", session(dev->dev));
+#else
+    snprintf(token, sizeof(token), "%u:%u", (unsigned)strtoul(dev->bus->dirname, NULL, 10), dev->devnum);
+#endif
+    return strcmp(token, pocket_usb_instance) == 0;
+}
+
 static struct usb_device_info * usb_device_is_valid(struct usb_device * dev) {
 
 	size_t i;
 	char product[1024];
 	struct usb_device_info * ret = NULL;
+
+	if (pocket_usb_instance && !pocket_matches_instance(dev))
+		return NULL;
 
 	for ( i = 0; i < sizeof(usb_devices)/sizeof(usb_devices[0]); ++i ) {
 
