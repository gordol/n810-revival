+/* Software overlay state remains full-frame throughout. Only the manual
+ * transfer's hardware shadow registers are cropped, under data_lock. */
+static int dss_update_region_check_locked(struct omap_overlay_manager *mgr,
+		u16 x, u16 y, u16 w, u16 h, struct omap_overlay **selected)
+{
+	struct mgr_priv_data *mp = get_mgr_priv(mgr);
+	struct omap_overlay *ovl, *gfx = NULL;
+	struct omap_overlay_info *oi;
+
+	if (!w || !h || x >= mp->timings.x_res || y >= mp->timings.y_res ||
+	    w > mp->timings.x_res - x || h > mp->timings.y_res - y)
+		return -EINVAL;
+	if (!x && !y && w == mp->timings.x_res && h == mp->timings.y_res) {
+		*selected = NULL;
+		return 0;
+	}
+	if (!mgr_manual_update(mgr) || (x & 1) || (w & 1))
+		return -EOPNOTSUPP;
+	list_for_each_entry(ovl, &mgr->overlays, list) {
+		if (!get_ovl_priv(ovl)->enabled)
+			continue;
+		if (gfx || ovl->id != OMAP_DSS_GFX)
+			return -EOPNOTSUPP;
+		gfx = ovl;
+	}
+	if (!gfx)
+		return -EOPNOTSUPP;
+	oi = &get_ovl_priv(gfx)->info;
+	if (oi->color_mode != OMAP_DSS_COLOR_RGB16 || oi->rotation || oi->mirror ||
+	    oi->rotation_type != OMAP_DSS_ROT_DMA || oi->pos_x || oi->pos_y ||
+	    oi->width != mp->timings.x_res || oi->height != mp->timings.y_res ||
+	    oi->screen_width < oi->width ||
+	    (oi->out_width && oi->out_width != oi->width) ||
+	    (oi->out_height && oi->out_height != oi->height) ||
+	    (u64)oi->paddr + ((u64)(y + h - 1) * oi->screen_width + x + w) * 2 > U32_MAX)
+		return -EOPNOTSUPP;
+	*selected = gfx;
+	return 0;
+}
+
+static int dss_mgr_check_update_region_compat(struct omap_overlay_manager *mgr,
+		u16 x, u16 y, u16 w, u16 h)
+{
+	unsigned long flags;
+	struct omap_overlay *ovl;
+	int r;
+
+	spin_lock_irqsave(&data_lock, flags);
+	r = dss_update_region_check_locked(mgr, x, y, w, h, &ovl);
+	spin_unlock_irqrestore(&data_lock, flags);
+	return r;
+}
+
+static void dss_restore_update_region_locked(struct omap_overlay_manager *mgr)
+{
+	struct mgr_priv_data *mp = get_mgr_priv(mgr);
+	struct omap_overlay *ovl;
+
+	if (!mp->update_region_active)
+		return;
+	list_for_each_entry(ovl, &mgr->overlays, list)
+		if (get_ovl_priv(ovl)->enabled)
+			get_ovl_priv(ovl)->info_dirty = true;
+	dss_mgr_write_regs(mgr);
+	dispc_mgr_set_timings(mgr->id, &mp->timings);
+	mp->update_region_active = false;
+}
+
+static int dss_mgr_start_update_region_compat(struct omap_overlay_manager *mgr,
+		u16 x, u16 y, u16 w, u16 h)
+{
+	struct mgr_priv_data *mp = get_mgr_priv(mgr);
+	struct omap_overlay *ovl;
+	struct omap_overlay_info crop;
+	struct omap_video_timings timings;
+	unsigned long flags;
+	int r;
+
+	spin_lock_irqsave(&data_lock, flags);
+	if (mp->updating) { r = -EBUSY; goto out; }
+	r = dss_update_region_check_locked(mgr, x, y, w, h, &ovl);
+	if (r) goto out;
+	r = dss_check_settings(mgr);
+	if (r) goto out;
+	dss_restore_update_region_locked(mgr);
+	dss_mgr_write_regs(mgr);
+	dss_mgr_write_regs_extra(mgr);
+	if (ovl) {
+		crop = get_ovl_priv(ovl)->info;
+		crop.paddr += ((u32)y * crop.screen_width + x) * 2;
+		crop.width = crop.out_width = w;
+		crop.height = crop.out_height = h;
+		crop.pos_x = crop.pos_y = 0;
+		timings = mp->timings;
+		timings.x_res = w;
+		timings.y_res = h;
+		mp->update_region_active = true;
+		r = dispc_ovl_setup(ovl->id, &crop,
+			dss_ovl_use_replication(mp->lcd_config, crop.color_mode),
+			&timings, false);
+		if (r) { dss_restore_update_region_locked(mgr); goto out; }
+		dispc_mgr_set_timings(mgr->id, &timings);
+	}
+	mp->updating = true;
+	if (!dss_data.irq_enabled && need_isr())
+		dss_register_vsync_isr();
+	dispc_mgr_enable_sync(mgr->id);
+out:
+	spin_unlock_irqrestore(&data_lock, flags);
+	return r;
+}
